def convert_size(size):
    if isinstance(size, str):
        if size.endswith("M"):
            return float(size[:-1])
        elif size.endswith("k"):
            return float(size[:-1]) / 1024
    return np.nan

apps["Size_MB"] = apps["Size"].apply(convert_size)
size_install = apps.dropna(
    subset=["Size_MB", "Installs"]
)
